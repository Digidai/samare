def generated_write(path, data, key, mode=0o600):
    if path.is_symlink():
        raise ValueError("This integration path is a symbolic link.")
    if path.exists():
        current = digest(path.read_bytes())
        if current == digest(data):
            if stat.S_IMODE(path.stat().st_mode) != mode:
                path.chmod(mode)
            set_value(key, current)
            return
        if current != setting(key):
            raise ValueError("An existing or modified integration is at this location. Its contents were preserved.")
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=str(path.parent), delete=False) as stream:
        name = stream.name
        stream.write(data)
        os.fchmod(stream.fileno(), mode)
    try:
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)
    set_value(key, digest(data))


def owned(path, key):
    recorded = setting(key)
    try:
        return bool(recorded) and not path.is_symlink() and path.is_file() and digest(path.read_bytes()) == recorded
    except OSError:
        return False


def generated_remove(path, key, expected=None):
    if path.exists() or path.is_symlink():
        matches_template = (expected is not None and not path.is_symlink() and path.is_file()
                            and path.read_bytes() == expected)
        if not matches_template and not owned(path, key):
            raise ValueError("The integration was modified. Its contents were preserved.")
        path.unlink()
    set_value(key, "")



def change_skill(client, installing):
    path = skill_path(client)
    key = "skill-" + client
    if redirected_skill(path):
        if installing and skill_status(client) == "current":
            return
        raise ValueError(f"The existing skill link at {path} was preserved.")
    if installing:
        generated_write(path, skill_content().encode(), key)
        return
    generated_remove(path, key, skill_content().encode())
    try:
        path.parent.rmdir()
    except OSError:
        pass


def redirected_skill(path):
    try:
        return (path.is_symlink() or path.parent.is_symlink()
                or not path.resolve().is_relative_to(INTEGRATION_HOME.resolve()))
    except (OSError, RuntimeError):
        return True


def using_fallback(client):
    path = skill_path(client)
    shared = skill_path("shared")
    if client == "shared" or not redirected_skill(path) or redirected_skill(shared):
        return False
    try:
        return path.resolve() == shared.resolve() and managed_status(
            shared, skill_content().encode(), "skill-shared") == "current"
    except (OSError, RuntimeError):
        return False


def skill_status(client):
    path = skill_path(client)
    if redirected_skill(path):
        return "current" if using_fallback(client) else "modified"
    return managed_status(path, skill_content().encode(), "skill-" + client)


def detect_client(client):
    if (INTEGRATION_HOME / CLIENT_DIRS[client]).is_dir():
        return True
    installed_apps = os.environ.get("SAMARE_DETECTED_CLIENTS", "").split(",")
    return client in installed_apps or shutil.which(client) is not None


def repair_integrations():
    issues = []
    try:
        change_command(True)
    except (OSError, ValueError) as error:
        issues.append(str(error))
    for client in CLIENT_DIRS:
        if detect_client(client):
            try:
                change_skill(client, True)
            except (OSError, ValueError) as error:
                issues.append(f"{client}: {error}")
    return issues


def agent_plist():
    return INTEGRATION_HOME / "Library" / "LaunchAgents" / (SERVICE_LABEL + ".plist")


def launchctl(*args, check=True):
    result = subprocess.run(["/bin/launchctl", *args], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, timeout=10)
    if check and result.returncode:
        raise ValueError("macOS could not update the background service: " + result.stderr.strip())
    return result.returncode


def wait_stopped():
    for _ in range(100):
        if not service_lock_held():
            return
        time.sleep(0.04)
    raise ValueError("The existing bridge did not stop in time.")


def stop_service():
    if control("status") and control("stop"):
        wait_stopped()


def spawn_service(log):
    # This helper intentionally outlives the CLI that starts it.
    with open(os.devnull, "rb") as stdin:
        actions = [(os.POSIX_SPAWN_DUP2, stdin.fileno(), 0),
                   (os.POSIX_SPAWN_DUP2, log.fileno(), 1),
                   (os.POSIX_SPAWN_DUP2, log.fileno(), 2)]
        return os.posix_spawn(sys.executable, [sys.executable, str(Path(__file__).resolve()), "serve"],
                              os.environ, file_actions=actions, setsid=True)


def start_service():
    live = control("status")
    # A waking helper can still own the listener while its first HTTP request
    # times out. Reuse that owner, or start a replacement once it exits.
    deadline = time.monotonic() + 12
    while not live and service_lock_held():
        if time.monotonic() >= deadline:
            raise ValueError("The existing local bridge has not resumed yet. Try again in a moment.")
        time.sleep(.04)
        live = control("status")
    if live and live.get("build") != SERVICE_BUILD:
        # A signed reply identifies our own older helper, including releases
        # predating build fingerprints. Never signal an unknown listener.
        stop_service()
        live = {}
    if not live:
        log_path = STATE / "service.log"
        with log_path.open("ab") as log:
            initial_size = log.tell()
            child = spawn_service(log)
        for _ in range(75):
            live = control("status")
            if live:
                break
            exited, code = os.waitpid(child, os.WNOHANG) if child else (0, 0)
            if exited and code:
                with log_path.open("rb") as log:
                    log.seek(max(initial_size, log_path.stat().st_size - 4096))
                    lines = log.read(4096).decode("utf-8", errors="replace").splitlines()
                reported = next((line[8:] for line in reversed(lines) if line.startswith("Bridge: ")), "")
                raise ValueError(reported or "The local bridge exited before startup; see service.log.")
            if exited:
                child = None
            # A second service may already hold service.lock while it is binding.
            time.sleep(.04)
    if not live.get("running"):
        raise ValueError("The local bridge did not become ready. See service.log in Bridge storage.")
    set_value("activated", "1")
    return live


def change_background(enabling, resume_foreground=True):
    plist = agent_plist()
    key = "background-plist"
    domain = "gui/" + str(os.getuid())
    target = domain + "/" + SERVICE_LABEL
    ours = owned(plist, key)
    if (plist.exists() or plist.is_symlink()) and not ours:
        raise ValueError("A background service configuration already exists here. Its contents were preserved.")
    # Custom installation homes (including --isolated) must never register a
    # job with the Mac's real user launchd domain.
    session_only = bool(os.environ.get("SAMARE_INTEGRATION_HOME"))
    loaded = not session_only and launchctl("print", target, check=False) == 0
    if loaded and not ours:
        raise ValueError("A service already uses this background label.")
    if not enabling:
        if loaded:
            launchctl("bootout", target)
            stop_service()
        generated_remove(plist, key)
        if loaded and resume_foreground and bridge_enabled():
            start_service()
        return
    if not bridge_enabled():
        raise ValueError("Enable the bridge before enabling its background service.")
    content = plistlib.dumps({
        "Label": SERVICE_LABEL,
        "ProgramArguments": [sys.executable, str(Path(__file__).resolve()), "serve"],
        "RunAtLoad": True,
        "EnvironmentVariables": {"SAMARE_BRIDGE_HOME": str(STATE)},
        "ProcessType": "Background"
    })
    if loaded and ours and plist.read_bytes() == content and control("status"):
        return
    if session_only:
        generated_write(plist, content, key)
        start_service()
        return
    old_content = plist.read_bytes() if ours else None
    was_running = bool(control("status"))
    if loaded:
        launchctl("bootout", target)
    stop_service()
    generated_write(plist, content, key)
    try:
        launchctl("bootstrap", domain, str(plist))
    except (OSError, ValueError, subprocess.SubprocessError):
        if old_content is None:
            generated_remove(plist, key)
        else:
            generated_write(plist, old_content, key)
            if loaded:
                launchctl("bootstrap", domain, str(plist), check=False)
        if was_running and not loaded:
            start_service()
        raise


def integrations():
    status = {client: skill_status(client) == "current" for client in CLIENT_DIRS}
    status["background"] = owned(agent_plist(), "background-plist")
    return status


def doctor():
    enabled = bridge_enabled()
    states = [managed_status(*item, executable=True) for item in command_files()]
    status = next(s for s in ("modified", "outdated", "missing", "current") if s in states)
    candidate = shutil.which(command_path().name)
    try:
        command_on_path = bool(status == "current" and candidate and Path(candidate).samefile(command_path()))
    except OSError:
        command_on_path = False
    details = {}
    issues = []
    if status == "modified" or enabled and status != "current":
        issues.append(f"Samare command: {status}.")
    for client in CLIENT_DIRS:
        state = skill_status(client)
        detected = detect_client(client)
        details[client] = {"detected": detected, "installed": state == "current",
                           "status": state, "path": str(skill_path(client)),
                           "usingFallback": state == "current" and using_fallback(client)}
        if state == "modified" or enabled and detected and state != "current":
            issues.append(f"{client}: skill {state} at {skill_path(client)}.")
    live = control("status")
    saved = int(setting("saved-port", setting("port", "0"))) or None
    return {
        "running": bool(live), "enabled": enabled,
        "port": live.get("port") or int(setting("port", "0")) or None,
        "savedPort": saved, "servingPorts": live.get("servingPorts", []),
        "portConflict": live.get("portConflict"),
        "background": owned(agent_plist(), "background-plist"),
        "backgroundScope": "session" if os.environ.get("SAMARE_INTEGRATION_HOME") else "login",
        "commandStatus": status, "commandInstalled": status == "current",
        "commandOnPath": command_on_path, "commandPath": str(command_path()),
        "fallbackPath": str(fallback_path()), "fallbackInstalled": states[0] == "current",
        "clients": {name: info["installed"] for name, info in details.items()},
        "clientDetails": details, "issues": issues,
    }


def print_doctor(as_json):
    info = doctor()
    if as_json:
        return print(json.dumps(info))
    print("Samare Agent Bridge")
    print("Use in Agent:", "enabled" if info["enabled"] else "disabled")
    print("Local service:", "running" if info["running"] else "stopped")
    if info["portConflict"]:
        conflict = info["portConflict"]
        owner = conflict.get("process") or "another process"
        print(f"Saved port {conflict['port']} is in use by {owner}. Serving links on {info['port']} while waiting.")
    print("Background:", "enabled" if info["background"] else "disabled")
    print(f"Command: {info['commandStatus']} ({info['commandPath']})")
    print("Command on PATH:", "yes" if info["commandOnPath"] else "no")
    print(f"Private fallback: {'current' if info['fallbackInstalled'] else 'unavailable'} ({info['fallbackPath']})")
    for name, item in info["clientDetails"].items():
        source = "shared fallback" if item["usingFallback"] else item["path"]
        print(f"{name}: {item['status']} ({source})")
    for issue in info["issues"]:
        print("Issue:", issue)


def signed(secret, value):
    return hmac.new(secret.encode(), value.encode(), hashlib.sha256).hexdigest()


class Handler(BaseHTTPRequestHandler):
    server_version = "SamareBridge"
    sys_version = ""

    def log_message(self, *args):
        # A document link grants access to one file. Keep it out of logs.
        pass

    @property
    def authority(self):
        return HOST + ":" + str(self.server.server_port)

    def send_data(self, code, body=b"", kind="text/plain; charset=utf-8", headers=()):
        self.send_response(code)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy", "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'")
        for key, value in headers:
            self.send_header(key, value)
        self.end_headers()
        if body:
            self.wfile.write(body)

    def json(self, code, data):
        self.send_data(code, json.dumps(data, ensure_ascii=False).encode("utf-8"), "application/json; charset=utf-8")

    def valid_origin(self, writing=False):
        if self.headers.get_all("Host", []) != [self.authority]:
            return False
        origins = self.headers.get_all("Origin", [])
        if origins and origins != ["http://" + self.authority]:
            return False
        if writing and (not origins or self.headers.get("Content-Type", "").split(";")[0].strip() != "application/json"):
            return False
        return not self.headers.get("Sec-Fetch-Site") == "cross-site" or not writing

    def control_nonce(self, action):
        nonce = self.headers.get("X-Samare-Nonce", "")
        proof = self.headers.get("X-Samare-Control", "")
        if not re.fullmatch(r"[a-f0-9]{32}", nonce) or not re.fullmatch(r"[a-f0-9]{64}", proof):
            return None
        valid = hmac.compare_digest(proof, signed(self.server.secret, action + ":" + nonce))
        return nonce if valid else None

    def do_GET(self):
        if not self.valid_origin():
            return self.json(403, {"error": "This request did not originate at the local bridge."})
        route = urlsplit(self.path).path
        if route == "/control/status":
            nonce = self.control_nonce("status")
            if nonce:
                return self.json(200, {**self.server.bridge_status, "proof": signed(self.server.secret, "reply:" + nonce)})
        match = re.fullmatch(r"/(d|api)/(" + DOC_ID + ")", route)
        try:
            if match:
                doc = lookup(match.group(2))
                if match.group(1) == "d":
                    return self.send_data(200, (HERE / "web.html").read_bytes(), "text/html; charset=utf-8")
                data = read_file(doc)
                rev = digest(data)
                if self.headers.get("If-None-Match") == '"' + rev + '"':
                    return self.send_data(304)
                result = {"name": doc.name, "displayPath": str(Path(doc.parent.name) / doc.name),
                          "text": data.decode("utf-8-sig"), "version": rev}
                session = parse_qs(urlsplit(self.path).query).get("reviewSession", [""])[0]
                if re.fullmatch(r"[a-f0-9]{32}",session):
                    with database() as db:
                        result["reviewClosed"] = bool(db.execute("SELECT 1 FROM pending_reviews WHERE doc=? AND session=? AND marked IS NULL",
                                                                 (match.group(2),session)).fetchone())
                return self.json(200,result)
            link = re.fullmatch(r"/(image|link)/(" + DOC_ID + ")", route)
            if link:
                params = parse_qs(urlsplit(self.path).query, keep_blank_values=True)
                if set(params) != {"ref"} or len(params["ref"]) != 1 or len(params["ref"][0]) > 4096:
                    raise FileNotFoundError
                is_image = link.group(1) == "image"
                answer = resolve_reference(link.group(2), params["ref"][0], is_image)
                if is_image:
                    mime, content = answer
                    return self.send_data(200, content, mime)
                return self.json(200, answer)
            asset = asset_file(route)
            if asset is not None and asset.is_file():
                kind = "text/javascript" if asset.suffix == ".js" else mimetypes.guess_type(asset.name)[0] or "application/octet-stream"
                return self.send_data(200, asset.read_bytes(), kind)
            self.json(404, {"error": "Link or resource not found."})
        except FileNotFoundError:
            self.json(404, {"error": "This document is unavailable."})
        except (ValueError, OSError):
            self.json(422, {"error": "Unable to read this document as UTF-8 text."})

    def do_POST(self):
        if not self.valid_origin(writing=True):
            return self.json(403, {"error": "Use this document's local bridge."})
        route = urlsplit(self.path).path
        if route == "/control/stop":
            nonce = self.control_nonce("stop")
            if nonce:
                self.json(200, {"stopping": True, "proof": signed(self.server.secret, "reply:" + nonce)})
                self.server.stop_event.set()
                return
        open_doc = re.fullmatch(r"/api/docs/(" + DOC_ID + r")/open-in-app", route)
        if open_doc:
            try:
                size = int(self.headers.get("Content-Length", "-1"))
                if size < 0 or size > 32 or json.loads(self.rfile.read(size)) != {}:
                    return self.json(400, {"error": "This action takes no parameters."})
                doc = lookup(open_doc.group(1))
                if doc.resolve(strict=True) != doc or not doc.is_file() or doc.suffix.lower() not in TYPES:
                    raise FileNotFoundError
                bundle = HERE.parent.parent.parent
                target = ["-a", str(bundle)] if bundle.suffix == ".app" else ["-b", "io.github.digidai.samare"]
                subprocess.run(["/usr/bin/open", *target, str(doc)], check=True, timeout=8,
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return self.json(200, {"opened": True})
            except FileNotFoundError:
                return self.json(404, {"error": "This document is unavailable."})
            except ValueError:
                return self.json(400, {"error": "This action takes no parameters."})
            except (OSError, subprocess.SubprocessError):
                return self.json(503, {"error": "Samare could not open this document."})
        if not re.fullmatch(r"/api/" + DOC_ID, route):
            return self.json(404, {"error": "Link not found."})
        try:
            size = int(self.headers.get("Content-Length", "-1"))
            if size < 0 or size > MAX_REQUEST:
                return self.json(413, {"error": "Unsupported request size."})
            doc = lookup(route[5:])
            payload = json.loads(self.rfile.read(size))
            if not isinstance(payload, dict):
                raise ValueError
            session = payload.get("reviewSession")
            if session is not None and (not isinstance(session,str) or not re.fullmatch(r"[a-f0-9]{32}",session)):
                raise ValueError
            if payload.get("finishReview") is True and session:
                with database() as db:
                    row = db.execute("SELECT version, marked FROM pending_reviews WHERE doc=? AND session=?",
                                     (route[5:],session)).fetchone()
                    if row is None:
                        raise StaleRevision
                    revision = atomic_save(doc,row[1],row[0]) if row[1] is not None else row[0]
                    db.execute("UPDATE pending_reviews SET marked=NULL,version=?,saved=? WHERE doc=? AND session=?",
                               (revision,time.time(),route[5:],session))
                return self.json(200, {"version":revision})
            rev = payload.get("version")
            if not isinstance(rev,str) or not re.fullmatch(r"[a-f0-9]{64}",rev):
                raise ValueError
            patch = payload.get("reviewPatch")
            if patch is not None:
                if not session or not isinstance(patch,dict) or not isinstance(patch.get("text"),str):
                    raise ValueError
                # DOM offsets count UTF-16 code units. Recheck this filesystem
                # revision again inside atomic_save before committing the patch.
                raw = read_file(doc)
                if digest(raw) != rev:
                    raise StaleRevision
                source = raw.decode("utf-8-sig").encode("utf-16-le")
                start, end = patch.get("from"), patch.get("to")
                if type(start) is not int or type(end) is not int or not 0 <= start <= end <= len(source)//2:
                    raise ValueError
                payload["text"] = (source[:start*2] + patch["text"].encode("utf-16-le") + source[end*2:]).decode("utf-16-le")
            if not isinstance(payload.get("text"),str):
                raise ValueError
            marked = payload.get("preparedReview")
            if marked is not None and (not session or not isinstance(marked,str)):
                raise ValueError
            revision = atomic_save(doc, payload["text"], rev)
            if session:
                with database() as db:
                    db.execute("DELETE FROM pending_reviews WHERE doc=? AND marked IS NOT NULL AND version<>?",
                               (route[5:],revision))
                    if marked is not None or payload.get("closeReview") is True:
                        db.execute("INSERT OR REPLACE INTO pending_reviews VALUES (?,?,?,?,?)",
                                   (route[5:],session,revision,marked,time.time()))
                    else:
                        db.execute("DELETE FROM pending_reviews WHERE doc=? AND session=?", (route[5:],session))
            self.json(200, {"version": revision})
        except StaleRevision:
            self.json(409, {"error": "Another edit was saved first."})
        except FileNotFoundError:
            self.json(404, {"error": "This document is unavailable."})
        except (ValueError, OSError):
            self.json(422, {"error": "Unable to save the document."})


def service_lock_held():
    try:
        with (STATE / "service.lock").open("rb") as lock:
            fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
            return False
    except BlockingIOError:
        return True
    except FileNotFoundError:
        return False


def control(action):
    port = int(setting("port", "0"))
    if not port or not service_lock_held():
        return {}
    connection = http.client.HTTPConnection(HOST, port, timeout=0.75)
    try:
        method = "GET" if action == "status" else "POST"
        authority = f"http://{HOST}:{port}"
        secret = setting("secret")
        nonce = secrets.token_hex(16)
        headers = {"Origin": authority, "X-Samare-Nonce": nonce,
                   "X-Samare-Control": signed(secret, action + ":" + nonce), "Content-Type": "application/json"}
        connection.request(method, "/control/" + action, headers=headers)
        response = connection.getresponse()
        if response.status != 200:
            return {}
        result = json.loads(response.read(4096))
        if not isinstance(result, dict) or result.get("proof") != signed(secret, "reply:" + nonce):
            return {}
        return result
    except (ValueError, OSError, http.client.HTTPException):
        return {}
    finally:
        connection.close()


def bind_server(port):
    try:
        return ThreadingHTTPServer((HOST, port), Handler)
    except OSError as exc:
        if not port or exc.errno != errno.EADDRINUSE:
            raise
        return None


def port_owner(port):
    result = {"port": port}
    try:
        output = subprocess.run(["/usr/sbin/lsof", "-nP", "-a", f"-iTCP:{port}", "-sTCP:LISTEN", "-Fpcn"],
                                capture_output=True, text=True, timeout=2).stdout
        pid, name = None, None
        for line in output.splitlines():
            if line.startswith("p"):
                pid, name = line[1:], None
            elif line.startswith("c"):
                name = line[1:]
            elif line in (f"n127.0.0.1:{port}", f"n*:{port}") and pid and name:
                result.update(pid=int(pid), process=name)
                break
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    return result


def serve():
    if not bridge_enabled():
        raise SetupRequired("Use in Agent is disabled. Enable it in Samare settings.")
    with (STATE / "service.lock").open("a+") as lock, contextlib.ExitStack() as stack:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        last = int(setting("port", "0"))
        saved = int(setting("saved-port", str(last)))
        ports = list(dict.fromkeys(port for port in [saved, last, *json.loads(setting("link-ports", "[]"))] if port))
        secret = setting("secret")
        status = {"running": True, "build": SERVICE_BUILD, "pid": os.getpid()}
        listeners = {}
        stop = threading.Event()
        selector = stack.enter_context(selectors.DefaultSelector())

        def listen(port):
            server = bind_server(port)
            if server is None:
                return None
            stack.enter_context(server)
            server.secret, server.bridge_status, server.stop_event = secret, status, stop
            listeners[server.server_port] = server
            selector.register(server, selectors.EVENT_READ)
            return server.server_port

        for port in ports:
            listen(port)
        if not listeners:
            port = listen(0)
            ports.append(port)
        if not saved:
            saved = next(iter(listeners))
        set_value("saved-port", saved)
        set_value("link-ports", json.dumps(ports))
        next_check = 0
        owner_check = 0
        while not stop.is_set():
            now = time.monotonic()
            if now >= next_check:
                for port in ports:
                    if port not in listeners:
                        listen(port)
                primary = saved if saved in listeners else next(iter(listeners))
                if status.get("port") != primary:
                    set_value("port", primary)
                if saved in listeners:
                    status["portConflict"] = None
                elif now >= owner_check:
                    status["portConflict"] = port_owner(saved)
                    owner_check = now + 5
                status.update(port=primary, savedPort=saved, servingPorts=list(listeners))
                next_check = now + 1
            for key, _ in selector.select(.2):
                key.fileobj.handle_request()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="action", required=True)
    link = sub.add_parser("url", help="get a persistent link for a local document")
    link.add_argument("file")
    link.add_argument("--asset-root", help="workspace root for images referenced by this note; default is its folder")
    sub.add_parser("resolve", help="resolve a registered link id on this Mac").add_argument("id")
    sub.add_parser("doctor", help="check the bridge").add_argument("--json", action="store_true")
    sub.add_parser("clients", help="show optional integrations").add_argument("--json", action="store_true")
    for name in ("install-skill", "remove-skill"):
        sub.add_parser(name).add_argument("client", choices=[*CLIENT_DIRS, "shared"])
    sub.add_parser("print-skill", help="print the agent skill for manual installation")
    sub.add_parser("install-command", help="install the user command and its private fallback")
    sub.add_parser("remove-command", help="remove this installation's managed command and fallback")
    sub.add_parser("repair", help="repair the command and skills for detected clients")
    sub.add_parser("background", help="manage the optional macOS login service").add_argument("state", choices=("enable", "disable"))
    for name in ("start", "stop", "enable", "disable", "serve", "app-open", "app-close"):
        sub.add_parser(name)
    argv = sys.argv[1:]
    # URL-safe identifiers can begin with a dash. Treat valid IDs as positional values.
    if len(argv) == 2 and argv[0] == "resolve" and re.fullmatch(DOC_ID, argv[1]):
        argv = ["resolve", "--", argv[1]]
    args = parser.parse_args(argv)
    if args.action == "print-skill":
        return print(skill_content(), end="")
    if not (STATE / "bridge.sqlite3").exists():
        if args.action in ("app-open", "app-close", "stop"):
            return
        if args.action == "doctor":
            return print_doctor(args.json)
        if args.action == "clients":
            return print(json.dumps(integrations()))
    prepare()
    if args.action == "serve":
        return serve()
    if args.action == "resolve":
        if not re.fullmatch(DOC_ID, args.id):
            raise ValueError("Invalid document id.")
        return print(lookup(args.id))
    with (STATE / "cli.lock").open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.action == "app-open" and not bridge_enabled():
            return
        if args.action == "app-close" and owned(agent_plist(), "background-plist"):
            return
        if args.action == "clients":
            return print(json.dumps(integrations()))
        if args.action in ("install-skill", "remove-skill"):
            return change_skill(args.client, args.action == "install-skill")
        if args.action in ("install-command", "remove-command"):
            return change_command(args.action == "install-command")
        if args.action == "background":
            return change_background(args.state == "enable")
        if args.action == "doctor":
            return print_doctor(args.json)
        if args.action == "disable":
            set_value("enabled", "0")
            try:
                if owned(agent_plist(), "background-plist"):
                    change_background(False, resume_foreground=False)
            finally:
                stop_service()
            return
        if args.action == "enable":
            set_value("enabled", "1")
        if args.action in ("stop", "app-close"):
            return stop_service()
        issues = repair_integrations() if args.action in ("enable", "repair") else []
        if args.action == "repair" and not bridge_enabled():
            if issues:
                raise ValueError("\n".join(issues))
            return
        if not bridge_enabled():
            raise SetupRequired("Use in Agent is disabled. Enable it in Samare settings.")
        link_id = register(args.file,args.asset_root) if args.action == "url" else None
        live = start_service()
        if issues:
            raise ValueError("\n".join(issues))
        if link_id:
            print(f"http://{HOST}:{live['port']}/d/{link_id}")


if __name__ == "__main__":
    try:
        main()
    except SetupRequired as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(78)
    except (OSError, ValueError, sqlite3.Error, subprocess.SubprocessError) as exc:
        print("Bridge:", str(exc) or "Document unavailable.", file=sys.stderr)
        sys.exit(1)

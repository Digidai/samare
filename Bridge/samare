def launcher_for(target):
    return ('#!/bin/sh\nexec ' + shlex.quote(str(target)) + ' "$@"\n').encode()


def command_files():
    return [(fallback_path(), launcher_for(Path(__file__).resolve()), "fallback-launcher"),
            (command_path(), launcher_for(fallback_path()), "command-launcher")]


def change_command(installing):
    files = command_files()
    if installing:
        # A foreign public command must not prevent the independently usable
        # private fallback from being installed, or vice versa.
        issues = []
        for path, content, key in files:
            try:
                generated_write(path, content, key, mode=0o700)
            except (OSError, ValueError) as error:
                issues.append(f"{path}: {error}")
        if issues:
            raise ValueError("\n".join(issues))
        return
    for path, expected, key in files:
        if managed_status(path, expected, key, executable=True) == "modified":
            raise ValueError(f"The existing file at {path} was preserved. Move it aside to repair this command.")
    for path, content, key in reversed(files):
        generated_remove(path, key, content)


def managed_status(path, content, key, executable=False):
    if not path.exists() and not path.is_symlink():
        return "missing"
    if path.is_symlink() or not path.is_file():
        return "modified"
    try:
        if path.read_bytes() == content:
            return "current" if not executable or os.access(path, os.X_OK) else "outdated"
    except OSError:
        return "modified"
    return "outdated" if owned(path, key) else "modified"



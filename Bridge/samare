def prepare():
    os.umask(0o077)
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    st = STATE.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        raise ValueError("Bridge storage must be a private directory owned by this user.")
    with database() as db:
        db.execute("CREATE TABLE IF NOT EXISTS settings (name TEXT PRIMARY KEY, value TEXT NOT NULL)")
        db.execute("CREATE TABLE IF NOT EXISTS pending_reviews (doc TEXT, session TEXT, version TEXT, marked TEXT, saved REAL, PRIMARY KEY(doc,session))")
        db.execute("DELETE FROM pending_reviews WHERE marked IS NULL AND saved < ?", (time.time() - 7*86400,))
        db.execute("CREATE TABLE IF NOT EXISTS documents (id TEXT PRIMARY KEY, path TEXT UNIQUE NOT NULL)")
        # Serialize first-time migrations when several agents request links together.
        db.execute("INSERT OR IGNORE INTO settings VALUES ('schema-version', '1')")
        if "asset_root" not in {row[1] for row in db.execute("PRAGMA table_info(documents)")}:
            db.execute("ALTER TABLE documents ADD COLUMN asset_root TEXT")
        db.execute("INSERT OR IGNORE INTO settings VALUES ('secret', ?)", (secrets.token_urlsafe(32),))


@contextlib.contextmanager
def database():
    db = sqlite3.connect(str(STATE / "bridge.sqlite3"), timeout=8)
    try:
        with db:
            yield db
    finally:
        db.close()


def setting(key, default=""):
    if not (STATE / "bridge.sqlite3").is_file():
        return default
    with database() as db:
        result = db.execute("SELECT value FROM settings WHERE name=?", (key,)).fetchone()
        return result[0] if result else default


def set_value(key, value):
    with database() as db:
        db.execute("INSERT OR REPLACE INTO settings VALUES (?, ?)", (key, str(value)))


def bridge_enabled():
    # Older versions recorded activation before they stored an explicit preference.
    return setting("enabled", setting("activated", "0")) == "1"


def lookup(doc_id):
    with database() as db:
        row = db.execute("SELECT path FROM documents WHERE id=?", (doc_id,)).fetchone()
    if row is None:
        raise FileNotFoundError
    return Path(row[0])


def register(path, asset_root=None):
    path = Path(path).expanduser().resolve(strict=True)
    if path.suffix.lower() not in TYPES or not path.is_file():
        raise ValueError("Choose a supported text document.")
    root = Path(asset_root).expanduser().resolve(strict=True) if asset_root else path.parent
    if not root.is_dir() or path != root and root not in path.parents:
        raise ValueError("The document must be inside its asset root.")
    with database() as db:
        db.execute("INSERT OR IGNORE INTO documents(id,path,asset_root) VALUES (?, ?, ?)", (secrets.token_urlsafe(24), str(path), str(root)))
        if asset_root:
            db.execute("UPDATE documents SET asset_root=? WHERE path=?", (str(root),str(path)))
        return db.execute("SELECT id FROM documents WHERE path=?", (str(path),)).fetchone()[0]


def resolve_reference(doc_id, ref, is_image):
    doc = lookup(doc_id)
    if doc.suffix.lower() not in references.MARKDOWN:
        raise FileNotFoundError
    ref = references.canonical_ref(ref)
    source = read_file(doc).decode("utf-8-sig")
    if ref not in references.references(source)[is_image]:
        raise FileNotFoundError
    with database() as db:
        root = Path(db.execute("SELECT asset_root FROM documents WHERE id=?", (doc_id,)).fetchone()[0] or doc.parent)
        if is_image:
            return references.raster(ref, doc, root)
        local, fragment = references.relative_name(ref)
        if not local:
            return {"id":doc_id, "heading":fragment}
        candidate = doc.parent / local
        clean = root / references.inside(candidate, root)
        candidates = [clean]
        if not clean.suffix:
            candidates.extend(clean.with_suffix(suffix) for suffix in sorted(references.MARKDOWN))
        for item in candidates:
            record = db.execute("SELECT id FROM documents WHERE path=?", (str(item),)).fetchone()
            if record:
                return {"id":record[0], "heading":fragment}
        if "/" not in local:
            # Resolve unqualified wiki names only among explicitly linked documents
            # inside this same registered workspace. Ambiguous names need a path.
            matches = [(i,p) for i,p in db.execute("SELECT id,path FROM documents") if root in Path(p).parents and Path(p).name in {c.name for c in candidates}]
            if len(matches) == 1:
                return {"id":matches[0][0], "heading":fragment}
    raise FileNotFoundError


def read_file(path):
    if path.resolve(strict=True) != path:
        raise ValueError("The linked file has moved.")
    fd = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as handle:
        if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
            raise ValueError("The linked item is no longer a regular file.")
        return handle.read()


def digest(data):
    return hashlib.sha256(data).hexdigest()


class StaleRevision(Exception):
    pass


class SetupRequired(Exception):
    pass


@contextlib.contextmanager
def coordinate_directory(path):
    # The native editor takes the same short-lived lock across its recheck and rename.
    directory = os.open(str(path), os.O_RDONLY | os.O_DIRECTORY)
    try:
        try:
            fcntl.flock(directory, fcntl.LOCK_EX)
        except OSError as exc:
            if exc.errno not in (errno.ENOTSUP, errno.EOPNOTSUPP):
                raise
        yield
    finally:
        os.close(directory)


def atomic_save(path, text, version):
    with WRITE_LOCK, coordinate_directory(path.parent):
        previous = read_file(path)
        if not hmac.compare_digest(digest(previous), version):
            raise StaleRevision
        encoding = "utf-8-sig" if previous.startswith(b"\xef\xbb\xbf") else "utf-8"
        if b"\r\n" in previous and b"\n" not in previous.replace(b"\r\n", b""):
            text = text.replace("\r\n", "\n").replace("\n", "\r\n")
        updated = text.encode(encoding)
        if updated == previous:
            return version
        with tempfile.NamedTemporaryFile(dir=str(path.parent), prefix=".samare-", delete=False) as tmp:
            name = tmp.name
        try:
            shutil.copystat(str(path), name, follow_symlinks=False)
            with open(name, "wb") as dest:
                dest.write(updated)
                dest.flush()
                os.fsync(dest.fileno())
            if digest(read_file(path)) != version:
                raise StaleRevision
            os.replace(name, str(path))
        finally:
            if os.path.lexists(name):
                os.unlink(name)
        return digest(updated)


def asset_file(route):
    local = {"/bridge.css": "web.css", "/bridge.js": "web.js"}
    if route in local:
        return HERE / local[route]
    if route in ("/samare-mark.svg", "/typefaces.css", "/editor.css", "/icons.js", "/editor.js", "/vendor/editor-libs.js", "/vendor/mermaid.min.js", "/vendor/katex.min.css", "/vendor/pele.global.js", "/diagram.js", "/review.js", "/review.css", "/lib/diff.min.js", "/merge.js"):
        return ASSETS / route[1:]
    if re.fullmatch(r"/(?:vendor/)?fonts/[A-Za-z0-9_.-]+\.(?:woff2?|ttf|otf)", route):
        return ASSETS / route[1:]
    return None


